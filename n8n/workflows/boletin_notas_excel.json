    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT pa.id_padre, pa.nombre || ' ' || pa.apellido AS padre_nombre, u_pa.email AS padre_email\nFROM padres pa\nJOIN usuarios u_pa ON u_pa.id_usuario = pa.id_usuario\nJOIN padre_hijo ph ON ph.id_padre = pa.id_padre;"
      },
