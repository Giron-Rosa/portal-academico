    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT \n    al.nombre || ' ' || al.apellido AS \"Estudiante\",\n    c.nombre AS \"Curso\",\n    'Tarea' AS \"Tipo Evaluacion\",\n    tc.titulo AS \"Evaluacion\",\n    nt.nota AS \"Nota\",\n    CASE WHEN nt.entregado THEN 'Sí' ELSE 'No' END AS \"Entregado\"\nFROM alumnos al\nJOIN matriculas m ON m.id_alumno = al.id_alumno AND m.estado = 'activa'\nJOIN aula_cursos ac ON ac.id_aula = m.id_aula\nJOIN cursos c ON c.id_curso = ac.id_curso\nJOIN tareas_curso tc ON tc.id_aula_curso = ac.id_aula_curso\nJOIN notas_tarea nt ON nt.id_tarea = tc.id_tarea AND nt.id_alumno = al.id_alumno\nWHERE al.id_alumno IN (SELECT id_alumno FROM padre_hijo WHERE id_padre = {{ $json.id_padre }})\n\nUNION ALL\n\nSELECT \n    al.nombre || ' ' || al.apellido AS \"Estudiante\",\n    c.nombre AS \"Curso\",\n    'Examen' AS \"Tipo Evaluacion\",\n    ec.titulo AS \"Evaluacion\",\n    ne.nota AS \"Nota\",\n    CASE WHEN ne.asistio THEN 'Sí' ELSE 'No' END AS \"Entregado\"\nFROM alumnos al\nJOIN matriculas m ON m.id_alumno = al.id_alumno AND m.estado = 'activa'\nJOIN aula_cursos ac ON ac.id_aula = m.id_aula\nJOIN cursos c ON c.id_curso = ac.id_curso\nJOIN examenes_curso ec ON ec.id_aula_curso = ac.id_aula_curso\nJOIN notas_examen ne ON ne.id_examen = ec.id_examen AND ne.id_alumno = al.id_alumno\nWHERE al.id_alumno IN (SELECT id_alumno FROM padre_hijo WHERE id_padre = {{ $json.id_padre }})\nORDER BY \"Estudiante\", \"Curso\", \"Tipo Evaluacion\", \"Evaluacion\";"
      },
